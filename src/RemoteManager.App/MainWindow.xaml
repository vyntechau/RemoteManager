<Window x:Class="RemoteManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:RemoteManager.App.ViewModels"
        xmlns:views="clr-namespace:RemoteManager.App.Views"
        Title="RemoteManager" Height="820" Width="1320"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/RemoteManager.App;component/Assets/vyntech-logo.png"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Sidebar Tab Item Style -->
        <Style x:Key="SidebarTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2.5" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}" Margin="4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title / Top Action Bar -->
            <RowDefinition Height="50"/>
            <!-- Main Work Area -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo / Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/RemoteManager.App;component/Assets/vyntech-logo.png" Width="26" Height="26" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="RemoteManager" FontWeight="SemiBold" FontSize="16"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search Input -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="420">
                    <ui:TextBox PlaceholderText="Search connections, hosts, protocols... (Ctrl+F)"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Height="34">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24"/>
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                </Grid>

                <!-- Top Right Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="+ New Credential" Command="{Binding AddCredentialCommand}" Appearance="Secondary" Height="32" Margin="0,0,8,0"/>
                    <ui:Button Content="+ New Server" Command="{Binding AddConnectionCommand}" Appearance="Primary" Height="32"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar Navigation & Server List -->
                <ColumnDefinition x:Name="SidebarColumn" Width="340" MinWidth="48" MaxWidth="500"/>
                <!-- Splitter -->
                <ColumnDefinition x:Name="SplitterColumn" Width="2"/>
                <!-- Right Work Area (Tabs, Dashboard, or Settings) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- 1. FULL EXPANDED SIDEBAR CONTENT -->
                    <Grid x:Name="SidebarExpandedContent" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <!-- Top Tabs: Servers & Vault -->
                            <RowDefinition Height="*"/>
                            <!-- Bottom Sticky Navigation: Settings & About (Menu Items) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                    <!-- TOP TAB COMPONENT -->
                    <TabControl x:Name="SidebarTabControl" Grid.Row="0"
                                ItemContainerStyle="{StaticResource SidebarTabItemStyle}"
                                SelectionChanged="OnSidebarTabChanged"
                                PreviewMouseLeftButtonDown="OnSidebarTabPreviewMouseDown"
                                Background="Transparent" BorderThickness="0" Padding="0">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!-- Modern Tab Headers Strip -->
                                    <Border Grid.Row="0" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="4,4,4,0">
                                        <Grid>
                                            <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
                                            <ui:Button Appearance="Transparent" Height="28" Width="28" Padding="0"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                       ToolTip="Collapse Sidebar (Ctrl+B)" Click="OnToggleSidebarClick" Cursor="Hand">
                                                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                    <!-- Active Tab Content -->
                                    <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                                </Grid>
                            </ControlTemplate>
                        </TabControl.Template>

                        <!-- TAB 1: SERVERS -->
                        <TabItem x:Name="ServersTab">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Server24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Servers" VerticalAlignment="Center"/>
                                    <ui:InfoBadge Value="{Binding FilteredConnections.Count}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Grid.Row="0" Padding="14,8" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <TextBlock Text="SAVED CONNECTIONS" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FilteredConnections.Count, StringFormat='{}{0} servers'}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Content="Hub" ToolTip="Open Connections Hub" Click="OnNavConnectionsClick"
                                                    Height="22" Padding="6,0" FontSize="10" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                 <!-- Connections List -->
                                 <ListBox x:Name="SidebarConnectionsList" Grid.Row="1" ItemsSource="{Binding FilteredConnections}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          BorderThickness="0" Background="Transparent" Padding="4,2"
                                          AllowDrop="True"
                                          PreviewMouseLeftButtonDown="OnSidebarItemPreviewMouseLeftButtonDown"
                                          MouseMove="OnSidebarItemMouseMove"
                                          DragOver="OnSidebarItemDragOver"
                                          Drop="OnSidebarItemDrop">
                                     <ListBox.ItemContainerStyle>
                                         <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                             <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                             <Setter Property="Padding" Value="0"/>
                                             <Setter Property="Margin" Value="2,1"/>
                                             <Setter Property="Cursor" Value="Hand"/>
                                         </Style>
                                     </ListBox.ItemContainerStyle>
                                     <ListBox.ItemTemplate>
                                         <DataTemplate>
                                             <Border Padding="8,6" Background="Transparent" CornerRadius="4"
                                                     Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     ToolTip="Double-click to connect • Drag to reorder • Right-click for options">
                                                 <Border.InputBindings>
                                                     <MouseBinding MouseAction="LeftDoubleClick"
                                                                   Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}"/>
                                                 </Border.InputBindings>
                                                 <Border.ContextMenu>
                                                     <ContextMenu>
                                                         <MenuItem Header="Connect (Embedded Tab)"
                                                                   Command="{Binding PlacementTarget.Tag.ConnectTabbedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                   CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                         <MenuItem Header="Connect (Fullscreen)"
                                                                   Command="{Binding PlacementTarget.Tag.ConnectFullscreenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                   CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                         <MenuItem Header="Connect (Native MSTSC Window)"
                                                                   Command="{Binding PlacementTarget.Tag.ConnectExternalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                   CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                         <Separator/>
                                                         <MenuItem Command="{Binding PlacementTarget.Tag.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                   CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                             <MenuItem.Style>
                                                                 <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                     <Setter Property="Header" Value="Bookmark Server (Show on Top)"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsBookmarked, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                                             <Setter Property="Header" Value="Remove Bookmark"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </MenuItem.Style>
                                                         </MenuItem>
                                                         <Separator/>
                                                         <MenuItem Header="Edit"
                                                                   Command="{Binding PlacementTarget.Tag.EditConnectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                   CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                         <Separator/>
                                                         <MenuItem Header="Export as RDP File..."
                                                                   Command="{Binding PlacementTarget.Tag.ExportConnectionToRdpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                   CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                         <MenuItem Header="Export Server (JSON)..."
                                                                   Command="{Binding PlacementTarget.Tag.ExportDataCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                   CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                         <Separator/>
                                                         <MenuItem Header="Delete"
                                                                   Command="{Binding PlacementTarget.Tag.DeleteConnectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                   CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                     </ContextMenu>
                                                 </Border.ContextMenu>

                                                 <Grid>
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="Auto"/>
                                                         <ColumnDefinition Width="*"/>
                                                         <ColumnDefinition Width="Auto"/>
                                                     </Grid.ColumnDefinitions>

                                                     <!-- Protocol Badge -->
                                                     <Border Grid.Column="0" Width="32" Height="22" CornerRadius="4" Margin="0,0,10,0"
                                                             VerticalAlignment="Center">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#0078D4"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Protocol}" Value="SSH">
                                                                         <Setter Property="Background" Value="#107C41"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Protocol}" Value="VNC">
                                                                         <Setter Property="Background" Value="#D83B01"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Protocol}" Value="Web">
                                                                         <Setter Property="Background" Value="#881798"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="{Binding Protocol}" FontSize="9" FontWeight="Bold" Foreground="White"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>

                                                     <!-- Name and Address -->
                                                     <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                         <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12"
                                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                         <TextBlock Text="{Binding FullAddress}" FontSize="11" Margin="0,1,0,0"
                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                     </StackPanel>

                                                     <!-- Bookmark Star Button (Empty star vs Golden star) -->
                                                     <Button Grid.Column="2" Width="26" Height="26" Padding="0" Background="Transparent"
                                                             BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Margin="4,0,0,0"
                                                             Command="{Binding DataContext.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding}"
                                                             Focusable="False">
                                                         <Button.Style>
                                                             <Style TargetType="Button">
                                                                 <Setter Property="Background" Value="Transparent"/>
                                                                 <Setter Property="Template">
                                                                     <Setter.Value>
                                                                         <ControlTemplate TargetType="Button">
                                                                             <Border x:Name="StarBtnBorder" Background="Transparent" CornerRadius="4">
                                                                                 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                             </Border>
                                                                             <ControlTemplate.Triggers>
                                                                                 <Trigger Property="IsMouseOver" Value="True">
                                                                                     <Setter TargetName="StarBtnBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                                                 </Trigger>
                                                                             </ControlTemplate.Triggers>
                                                                         </ControlTemplate>
                                                                     </Setter.Value>
                                                                 </Setter>
                                                             </Style>
                                                         </Button.Style>
                                                         <Button.ToolTip>
                                                             <ToolTip>
                                                                 <TextBlock>
                                                                     <TextBlock.Style>
                                                                         <Style TargetType="TextBlock">
                                                                             <Setter Property="Text" Value="Bookmark server (show on top)"/>
                                                                             <Style.Triggers>
                                                                                 <DataTrigger Binding="{Binding IsBookmarked}" Value="True">
                                                                                     <Setter Property="Text" Value="Remove Bookmark"/>
                                                                                 </DataTrigger>
                                                                             </Style.Triggers>
                                                                         </Style>
                                                                     </TextBlock.Style>
                                                                 </TextBlock>
                                                             </ToolTip>
                                                         </Button.ToolTip>
                                                         <ui:SymbolIcon Symbol="Star24" FontSize="14">
                                                             <ui:SymbolIcon.Style>
                                                                 <Style TargetType="ui:SymbolIcon">
                                                                     <!-- Unbookmarked: subtle outline star -->
                                                                     <Setter Property="Foreground" Value="#50FFFFFF"/>
                                                                     <Setter Property="Opacity" Value="0.45"/>
                                                                     <Setter Property="Filled" Value="False"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding IsBookmarked}" Value="True">
                                                                             <!-- Bookmarked: vivid golden star! -->
                                                                             <Setter Property="Foreground" Value="#FFB900"/>
                                                                             <Setter Property="Opacity" Value="1.0"/>
                                                                             <Setter Property="Filled" Value="True"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </ui:SymbolIcon.Style>
                                                         </ui:SymbolIcon>
                                                     </Button>
                                                 </Grid>
                                             </Border>
                                         </DataTemplate>
                                     </ListBox.ItemTemplate>
                                 </ListBox>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: VAULT -->
                        <TabItem x:Name="VaultTab">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Key24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Vault" VerticalAlignment="Center"/>
                                    <ui:InfoBadge Value="{Binding Credentials.Count}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="14,10" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Grid>
                                        <TextBlock Text="CREDENTIAL VAULT (DPAPI)" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                        <Button Content="+ Add" Command="{Binding AddCredentialCommand}" HorizontalAlignment="Right" Height="24" Padding="6,0" />
                                    </Grid>
                                </Border>

                                <ListBox Grid.Row="1" ItemsSource="{Binding Credentials}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         BorderThickness="0" Background="Transparent" Padding="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2,3" Padding="10,8" CornerRadius="6"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Edit"
                                                                  Command="{Binding PlacementTarget.Tag.EditCredentialCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <MenuItem Header="Delete"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteCredentialCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Username}" FontSize="11" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Content="Edit" Height="26" Padding="8,0" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.EditCredentialCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <ui:Button Content="Delete" Height="26" Padding="8,0" Appearance="Danger"
                                                                Command="{Binding DataContext.DeleteCredentialCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- BOTTOM STICKY NAVIGATION: FLUENT UI NAVIGATION -->
                    <Grid Grid.Row="1" Margin="6,2,6,6">
                        <ui:NavigationView x:Name="SidebarFooterNav"
                                           PaneDisplayMode="Left"
                                           IsBackButtonVisible="Collapsed"
                                           IsPaneToggleVisible="False"
                                           IsPaneOpen="True"
                                           OpenPaneLength="320"
                                           Background="Transparent"
                                           Header="{x:Null}">
                            <ui:NavigationView.FooterMenuItems>
                                <ui:NavigationViewItem x:Name="NavConnectionsItem"
                                                       Content="Connections Hub"
                                                       Tag="Connections"
                                                       Icon="{ui:SymbolIcon Symbol=ServerMultiple20}"
                                                       IsActive="True"
                                                       Click="OnNavConnectionsClick" />
                                <ui:NavigationViewItem x:Name="NavLogsItem"
                                                       Content="Logs"
                                                       Tag="Logs"
                                                       Icon="{ui:SymbolIcon Symbol=DocumentBulletList24}"
                                                       Click="OnNavLogsClick" />
                                <ui:NavigationViewItem x:Name="NavSettingsItem"
                                                       Content="Settings"
                                                       Tag="Settings"
                                                       Icon="{ui:SymbolIcon Symbol=Settings24}"
                                                       Click="OnNavSettingsClick" />
                                <ui:NavigationViewItem x:Name="NavAboutItem"
                                                       Content="About"
                                                       Tag="About"
                                                       Icon="{ui:SymbolIcon Symbol=Info24}"
                                                       Click="OnNavAboutClick" />
                            </ui:NavigationView.FooterMenuItems>
                        </ui:NavigationView>
                    </Grid>
                    </Grid>

                    <!-- 2. COMPACT COLLAPSED ICON RAIL (SHOWN WHEN SIDEBAR IS COLLAPSED) -->
                    <Grid x:Name="SidebarCollapsedContent" Visibility="Collapsed" Width="48" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <!-- Top action icons (Expand, Servers, Vault, Hub) -->
                            <RowDefinition Height="*"/>
                            <!-- Bottom utility icons (Logs, Settings, About) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Icon Stack -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <!-- Expand Button -->
                            <ui:Button Appearance="Transparent" Width="36" Height="34" Padding="0" Margin="0,0,0,8"
                                       ToolTip="Expand Sidebar (Ctrl+B)" Click="OnToggleSidebarClick" Cursor="Hand">
                                <ui:SymbolIcon Symbol="ChevronRight24" FontSize="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </ui:Button>

                            <!-- Servers Tab Icon -->
                            <ui:Button x:Name="CollapsedServersBtn" Appearance="Transparent" Width="36" Height="36" Padding="0" Margin="0,0,0,6"
                                       ToolTip="Servers (Saved Connections)" Click="OnCollapsedServersClick" Cursor="Hand">
                                <ui:SymbolIcon Symbol="Server24" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </ui:Button>

                            <!-- Vault Tab Icon -->
                            <ui:Button x:Name="CollapsedVaultBtn" Appearance="Transparent" Width="36" Height="36" Padding="0" Margin="0,0,0,6"
                                       ToolTip="Credential Vault" Click="OnCollapsedVaultClick" Cursor="Hand">
                                <ui:SymbolIcon Symbol="Key24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </ui:Button>

                            <!-- Connections Hub Icon -->
                            <ui:Button Appearance="Transparent" Width="36" Height="36" Padding="0" Margin="0,0,0,6"
                                       ToolTip="Connections Hub" Click="OnNavConnectionsClick" Cursor="Hand">
                                <ui:SymbolIcon Symbol="ServerMultiple20" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </ui:Button>
                        </StackPanel>

                        <!-- Bottom Icon Stack -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <!-- Logs Icon -->
                            <ui:Button Appearance="Transparent" Width="36" Height="36" Padding="0" Margin="0,0,0,4"
                                       ToolTip="Application Logs" Click="OnNavLogsClick" Cursor="Hand">
                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </ui:Button>

                            <!-- Settings Icon -->
                            <ui:Button Appearance="Transparent" Width="36" Height="36" Padding="0" Margin="0,0,0,4"
                                       ToolTip="Settings" Click="OnNavSettingsClick" Cursor="Hand">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </ui:Button>

                            <!-- About Icon -->
                            <ui:Button Appearance="Transparent" Width="36" Height="36" Padding="0" Margin="0,0,0,2"
                                       ToolTip="About RemoteManager" Click="OnNavAboutClick" Cursor="Hand">
                                <ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter x:Name="MainGridSplitter" Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="{DynamicResource ControlElevationBorderBrush}"/>

            <!-- RIGHT WORK AREA: SESSIONS / DASHBOARD OR SETTINGS -->
            <Grid Grid.Column="2">
                <!-- WORK AREA 1: SESSIONS OR DASHBOARD -->
                <Grid x:Name="SessionsAndDashboardArea" Visibility="Visible">
                    <!-- If Sessions are open: Tab Bar + Tab Content -->
                    <Grid x:Name="ActiveSessionsArea">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSessions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab Header Bar -->
                        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding ActiveSessions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                             <Border Margin="2,4,2,0" Padding="12,0" CornerRadius="6,6,0,0"
                                                     BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1,1,1,0"
                                                     Height="34" Cursor="Hand">
                                                 <Border.Style>
                                                     <Style TargetType="Border">
                                                         <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                 <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Border.Style>
                                                 <Border.InputBindings>
                                                     <MouseBinding MouseAction="LeftClick"
                                                                   Command="{Binding DataContext.SelectSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}"/>
                                                 </Border.InputBindings>
                                                 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <!-- Protocol Tag (hidden for utility tabs) -->
                                                    <Border CornerRadius="3" Padding="4,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#0078D4"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Protocol}" Value="SSH">
                                                                        <Setter Property="Background" Value="#107C41"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Protocol}" Value="VNC">
                                                                        <Setter Property="Background" Value="#D83B01"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Protocol}" Value="Web">
                                                                        <Setter Property="Background" Value="#881798"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsUtilityTab}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Protocol}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                    </Border>

                                                    <!-- Utility Tab Icon (visible only for utility tabs) -->
                                                    <ui:SymbolIcon FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Symbol" Value="Edit24"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUtilityTab}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding UtilityTabTag}" Value="Settings">
                                                                        <Setter Property="Symbol" Value="Settings24"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding UtilityTabTag}" Value="Logs">
                                                                        <Setter Property="Symbol" Value="DocumentBulletList24"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding UtilityTabTag}" Value="About">
                                                                        <Setter Property="Symbol" Value="Info24"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding UtilityTabTag}" Value="Connections">
                                                                        <Setter Property="Symbol" Value="ServerMultiple20"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>

                                                    <!-- Tab Title -->
                                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                    <!-- Fullscreen Button (hidden for utility tabs) -->
                                                    <Button Content="⛶" ToolTip="Toggle Fullscreen (F11)" Height="20" Width="20" Padding="0"
                                                            Command="{Binding FullscreenCommand}" Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUtilityTab}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Pop Out Button (hidden for utility tabs) -->
                                                    <Button Content="↗" ToolTip="Pop out to separate window" Height="20" Width="20" Padding="0"
                                                            Command="{Binding PopOutCommand}" Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUtilityTab}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>

                                                    <!-- Close Button -->
                                                    <Button Content="✕" Height="20" Width="20" Padding="0"
                                                            Command="{Binding CloseCommand}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="ToolTip" Value="Disconnect and close tab"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUtilityTab}" Value="True">
                                                                        <Setter Property="ToolTip" Value="Close tab"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Tab Body / Active Session Display -->
                        <ContentControl x:Name="SessionContentPresenter" Grid.Row="1" />
                    </Grid>

                    <!-- Welcome Dashboard (Connections Hub shown when no tabs are active) -->
                    <Grid x:Name="WelcomeDashboard" Background="{DynamicResource ApplicationBackgroundBrush}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSessions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <views:ConnectionsView DataContext="{Binding ConnectionsVM}" />
                    </Grid>
                </Grid>

                <!-- WORK AREA 2: SEPARATE MODERN SETTINGS PAGE -->
                <Grid x:Name="SettingsPageArea" Visibility="Collapsed">
                    <views:SettingsView x:Name="SettingsViewControl" />
                </Grid>

                <!-- WORK AREA 3: SEPARATE COMPLETE ABOUT PAGE -->
                <Grid x:Name="AboutPageArea" Visibility="Collapsed">
                    <views:AboutView x:Name="AboutViewControl" />
                </Grid>

                <!-- WORK AREA 4: SEPARATE MODERN LOGS PAGE -->
                <Grid x:Name="LogsPageArea" Visibility="Collapsed">
                    <views:LogsView x:Name="LogsViewControl" />
                </Grid>

                <!-- WORK AREA 5: DEDICATED CONNECTIONS PAGE -->
                <Grid x:Name="ConnectionsPageArea" Visibility="Collapsed">
                    <views:ConnectionsView x:Name="ConnectionsViewControl" DataContext="{Binding ConnectionsVM}" />
                </Grid>

                <!-- WORK AREA 6: DEDICATED CONNECTION EDIT PAGE -->
                <Grid x:Name="ConnectionEditPageArea" Visibility="Collapsed">
                    <views:ConnectionEditView x:Name="ConnectionEditControl" />
                </Grid>

                <!-- WORK AREA 7: DEDICATED CREDENTIAL EDIT PAGE -->
                <Grid x:Name="CredentialEditPageArea" Visibility="Collapsed">
                    <views:CredentialEditView x:Name="CredentialEditControl" />
                </Grid>
            </Grid>
        </Grid>


        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                Padding="12,0" Height="28">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding ActiveSessions.Count, StringFormat='Active Sessions: {0}'}" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Local DPAPI Encrypted Vault" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right-aligned Version & Update Status Line -->
                <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Cursor="Hand" MouseLeftButtonDown="OnFooterUpdateStatusClick"
                        Background="Transparent" Padding="6,2" CornerRadius="4"
                        ToolTip="Click to view update details in About page">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Margin="0,0,5,0"
                                       Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVis}}"/>
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Margin="0,0,5,0"
                                       Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding FooterUpdateStatusText}" FontSize="11" FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
