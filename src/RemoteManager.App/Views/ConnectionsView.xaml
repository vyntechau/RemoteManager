<UserControl x:Class="RemoteManager.App.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:RemoteManager.App.ViewModels"
             Background="{DynamicResource ApplicationBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Card Hover and Selection Style -->
        <Style x:Key="ConnectionCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Filter Pill Button Style -->
        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Data Table Header Style -->
        <Style x:Key="FluentColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Table Row Style -->
        <Style x:Key="FluentTableRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <!-- 1. Page Header with Title & KPI Chips -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Action & Filter Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Collapsible Quick Connect Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 4. Main Content: Grid / Table / Empty State -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. PAGE HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ServerMultiple20" FontSize="26" Margin="0,0,10,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Connections &amp; Remote Servers" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Centralized management hub for RDP, SSH, VNC, and Web console sessions"
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="36,4,0,0"/>
            </StackPanel>

            <!-- Top Right: Filter Select Box with Multi-Checkbox & Total Server Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Total Servers Metric Badge -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ServerMultiple20" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Total: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Modern Fluent UI Select Box Dropdown -->
                <Grid VerticalAlignment="Center">
                    <ToggleButton x:Name="FilterDropdownButton"
                                  Height="34"
                                  Padding="10,0"
                                  Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="DropdownBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DropdownBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    <Setter TargetName="DropdownBorder" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="DropdownBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    <Setter TargetName="DropdownBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveFilter}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Filter Icon -->
                            <ui:SymbolIcon Symbol="Filter24" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveFilter}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>

                            <!-- Filter Summary Label -->
                            <TextBlock Text="{Binding ActiveFilterSummary}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <!-- Active Filter Count Pill Badge -->
                            <Border CornerRadius="10" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveFilter}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ActiveFilterBadgeText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>

                            <!-- Chevron Down Icon -->
                            <ui:SymbolIcon Symbol="ChevronDown16" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Popup DropDown with Multi Checkboxes -->
                    <Popup x:Name="FilterPopup"
                           PlacementTarget="{Binding ElementName=FilterDropdownButton}"
                           IsOpen="{Binding IsChecked, ElementName=FilterDropdownButton, Mode=TwoWay}"
                           StaysOpen="False"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           VerticalOffset="4">
                        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12"
                                Width="300"
                                Margin="0,0,12,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.45"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Header: Title & Reset Action -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Filter24" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Filter by Category" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Reset All" Command="{Binding ResetFiltersCommand}"
                                            Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Grid>

                                <Rectangle Height="1" Fill="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,8"/>

                                <!-- SECTION: GENERAL -->
                                <TextBlock Text="GENERAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="4,0,0,4"/>

                                <!-- All Servers (Total) Checkbox -->
                                <CheckBox IsChecked="{Binding IsFilterAll, Mode=TwoWay}" Margin="0,2" Padding="6,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="SelectAllOn24" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="All Servers" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border Grid.Column="2" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding TotalCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </CheckBox>

                                <!-- Bookmarked Checkbox -->
                                <CheckBox IsChecked="{Binding IsFilterBookmarked, Mode=TwoWay}" Margin="0,2" Padding="6,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="Star24" Filled="True" FontSize="14" Foreground="#FFB900" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Bookmarked" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border Grid.Column="2" Background="#20FFB900" BorderBrush="#40FFB900" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding BookmarkedCount}" FontSize="11" FontWeight="Bold" Foreground="#FFB900"/>
                                        </Border>
                                    </Grid>
                                </CheckBox>

                                <Rectangle Height="1" Fill="{DynamicResource ControlElevationBorderBrush}" Margin="0,6,0,6"/>

                                <!-- SECTION: PROTOCOLS -->
                                <TextBlock Text="PROTOCOLS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="4,0,0,4"/>

                                <!-- RDP Checkbox -->
                                <CheckBox IsChecked="{Binding IsFilterRdp, Mode=TwoWay}" Margin="0,2" Padding="6,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="Desktop24" FontSize="14" Foreground="#0078D4" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Remote Desktop (RDP)" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border Grid.Column="2" Background="#200078D4" BorderBrush="#400078D4" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding RdpCount}" FontSize="11" FontWeight="Bold" Foreground="#0078D4"/>
                                        </Border>
                                    </Grid>
                                </CheckBox>

                                <!-- SSH Checkbox -->
                                <CheckBox IsChecked="{Binding IsFilterSsh, Mode=TwoWay}" Margin="0,2" Padding="6,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="WindowConsole20" FontSize="14" Foreground="#107C41" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="SSH Terminal" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border Grid.Column="2" Background="#20107C41" BorderBrush="#40107C41" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding SshCount}" FontSize="11" FontWeight="Bold" Foreground="#107C41"/>
                                        </Border>
                                    </Grid>
                                </CheckBox>

                                <!-- VNC Checkbox -->
                                <CheckBox IsChecked="{Binding IsFilterVnc, Mode=TwoWay}" Margin="0,2" Padding="6,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="SlideTextSparkle24" FontSize="14" Foreground="#D83B01" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="VNC Screen" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border Grid.Column="2" Background="#20D83B01" BorderBrush="#40D83B01" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding VncCount}" FontSize="11" FontWeight="Bold" Foreground="#D83B01"/>
                                        </Border>
                                    </Grid>
                                </CheckBox>

                                <!-- Web Checkbox -->
                                <CheckBox IsChecked="{Binding IsFilterWeb, Mode=TwoWay}" Margin="0,2" Padding="6,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="Globe24" FontSize="14" Foreground="#881798" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Web Console" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border Grid.Column="2" Background="#20881798" BorderBrush="#40881798" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding WebCount}" FontSize="11" FontWeight="Bold" Foreground="#881798"/>
                                        </Border>
                                    </Grid>
                                </CheckBox>

                                <Rectangle Height="1" Fill="{DynamicResource ControlElevationBorderBrush}" Margin="0,6,0,6"/>

                                <!-- SECTION: STATUS -->
                                <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="4,0,0,4"/>

                                <!-- Online Only Checkbox -->
                                <CheckBox IsChecked="{Binding IsFilterOnlineOnly, Mode=TwoWay}" Margin="0,2" Padding="6,4" HorizontalAlignment="Stretch" Cursor="Hand">
                                    <Grid Margin="4,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="Pulse24" FontSize="14" Foreground="#10b981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Online Only" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <Border Grid.Column="2" Background="#2010b981" BorderBrush="#4010b981" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{Binding OnlineCount}" FontSize="11" FontWeight="Bold" Foreground="#10b981"/>
                                        </Border>
                                    </Grid>
                                </CheckBox>

                                <Rectangle Height="1" Fill="{DynamicResource ControlElevationBorderBrush}" Margin="0,8,0,6"/>

                                <!-- Footer Info -->
                                <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="Showing "/>
                                    <Run Text="{Binding FilteredCards.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Run Text=" of "/>
                                    <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Run Text=" servers"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 2. ACTION & FILTER TOOLBAR -->
        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Protocol Pills & Sort -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Protocol Pills -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="All" Command="{Binding SetProtocolFilterCommand}" CommandParameter="All">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="★ Bookmarked" Command="{Binding SetProtocolFilterCommand}" CommandParameter="Bookmarked">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterBookmarked}" Value="True">
                                            <Setter Property="Background" Value="#FFB900"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="BorderBrush" Value="#FFB900"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="RDP" Command="{Binding SetProtocolFilterCommand}" CommandParameter="RDP">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterRdp}" Value="True">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#0078D4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="SSH" Command="{Binding SetProtocolFilterCommand}" CommandParameter="SSH">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterSsh}" Value="True">
                                            <Setter Property="Background" Value="#107C41"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#107C41"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="VNC" Command="{Binding SetProtocolFilterCommand}" CommandParameter="VNC">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterVnc}" Value="True">
                                            <Setter Property="Background" Value="#D83B01"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#D83B01"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Web" Command="{Binding SetProtocolFilterCommand}" CommandParameter="Web">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterWeb}" Value="True">
                                            <Setter Property="Background" Value="#881798"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#881798"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Sort By ComboBox -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Sort:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                                  Width="175" Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Right: Action Buttons & View Mode Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Ping -->
                    <ui:Button Command="{Binding PingAllCommand}" Appearance="Secondary" Height="34" Margin="0,0,8,0"
                            ToolTip="Check network reachability for all visible servers" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Pulse24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Ping" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Quick Connect Toggle -->
                    <ui:Button Command="{Binding ToggleQuickConnectCommand}" Appearance="Secondary" Height="34" Margin="0,0,12,0"
                            ToolTip="Toggle inline Quick Connect bar" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Quick Connect" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- View Switcher (Grid vs Table) -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <!-- Grid Button -->
                            <Button ToolTip="Card Grid View" Command="{Binding SetViewModeCommand}" CommandParameter="Grid"
                                    Width="32" Height="28" Padding="0" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <ui:SymbolIcon Symbol="Grid24" FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </Button>
                            <!-- Table Button -->
                            <Button ToolTip="Dense Table View" Command="{Binding SetViewModeCommand}" CommandParameter="Table"
                                    Width="32" Height="28" Padding="0" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTableView}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <ui:SymbolIcon Symbol="Table24" FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. COLLAPSIBLE QUICK CONNECT BAR -->
        <Border Grid.Row="2" Visibility="{Binding IsQuickConnectExpanded, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="Flash24" FontSize="16" Foreground="#FFB900" Margin="0,0,6,0"/>
                    <TextBlock Text="Instant Connect:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Protocol combo -->
                <ComboBox Grid.Column="1" SelectedIndex="0" Height="34" VerticalContentAlignment="Center"
                          x:Name="QuickPageProtocolCombo" SelectionChanged="OnQuickProtocolChanged">
                    <ComboBoxItem Content="RDP" Tag="RDP" IsSelected="True"/>
                    <ComboBoxItem Content="SSH" Tag="SSH"/>
                    <ComboBoxItem Content="VNC" Tag="VNC"/>
                    <ComboBoxItem Content="Web" Tag="Web"/>
                </ComboBox>

                <!-- Host input -->
                <ui:TextBox Grid.Column="3" PlaceholderText="Host or IP:Port (e.g. 192.168.1.100 or myserver.domain.com:3389)"
                            Text="{Binding QuickHost, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"/>

                <!-- Connect Button -->
                <ui:Button Grid.Column="5" Content="Connect Now" Appearance="Primary" Height="34" Padding="18,0"
                           Command="{Binding QuickConnectFromPageCommand}"/>
            </Grid>
        </Border>

        <!-- 4. MAIN CONTENT AREA: CARDS GRID OR TABLE VIEW -->
        <Grid Grid.Row="3">
            <!-- 4A. CARD GRID VIEW -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding FilteredCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="315" Margin="0,0,14,14" Style="{StaticResource ConnectionCardBorderStyle}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Cursor="Hand" ToolTip="Double-click to connect • Right-click for options">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.ConnectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>

                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Connect (Embedded Tab)"
                                                  Command="{Binding PlacementTarget.Tag.ConnectTabbedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Connect (Fullscreen)"
                                                  Command="{Binding PlacementTarget.Tag.ConnectFullscreenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Connect (Native MSTSC / Window)"
                                                  Command="{Binding PlacementTarget.Tag.ConnectExternalCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Header="Ping / Test Port"
                                                  Command="{Binding PlacementTarget.Tag.PingCardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Copy Address"
                                                  Command="{Binding PlacementTarget.Tag.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <Separator/>
                                        <MenuItem Command="{Binding PlacementTarget.Tag.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Header" Value="Bookmark Server (Show on Top)"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PlacementTarget.DataContext.IsBookmarked, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True">
                                                            <Setter Property="Header" Value="Remove Bookmark"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Edit Connection"
                                                  Command="{Binding PlacementTarget.Tag.EditConnectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Duplicate Connection"
                                                  Command="{Binding PlacementTarget.Tag.DuplicateConnectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Delete Connection"
                                                  Command="{Binding PlacementTarget.Tag.DeleteConnectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid Margin="16,14">
                                    <Grid.RowDefinitions>
                                        <!-- Top Row: Protocol Badge, Ping Status, Bookmark & Options -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Server Name & Address -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Metadata Pills: Credential, Display Mode -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Action Buttons -->
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Protocol Badge -->
                                        <Border Grid.Column="0" CornerRadius="4" Padding="8,3" Background="{Binding ProtocolBadgeColor}">
                                            <TextBlock Text="{Binding Protocol}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <!-- Live Ping Status Pill -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Ellipse Width="7" Height="7" Fill="{Binding PingStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PingStatusText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Bookmark Star Button (Empty star vs Golden star) -->
                                        <Button Grid.Column="2" Width="26" Height="26" Padding="0" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" Margin="0,0,4,0" ToolTip="{Binding BookmarkTooltip}"
                                                Command="{Binding DataContext.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Focusable="False">
                                            <ui:SymbolIcon Symbol="Star24" FontSize="14" Foreground="{Binding BookmarkIconColor}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Setter Property="Filled" Value="False"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBookmarked}" Value="True">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                                <Setter Property="Filled" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Button>

                                        <!-- Options Menu Trigger -->
                                        <Button Grid.Column="3" Content="•••" Width="26" Height="26" Padding="0" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" ToolTip="More Options"
                                                Click="OnCardMenuClick"/>
                                    </Grid>

                                    <!-- Server Name & Address -->
                                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FullAddress}" FontSize="12" FontFamily="Consolas, Segoe UI"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Metadata Pills -->
                                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                                        <!-- Credential Badge -->
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Key24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CredentialTitle}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Display Mode Badge -->
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding DisplayModeText}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Card Action Buttons -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Connect Button -->
                                        <ui:Button Grid.Column="0" Content="Connect" Appearance="Primary" Height="30"
                                                   HorizontalAlignment="Stretch"
                                                   Command="{Binding DataContext.ConnectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>

                                        <!-- Ping Test Button -->
                                        <Button Grid.Column="2" Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip="Test network reachability"
                                                Command="{Binding DataContext.PingCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Pulse24" FontSize="13"/>
                                        </Button>

                                        <!-- Edit Button -->
                                        <Button Grid.Column="4" Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip="Edit connection settings"
                                                Command="{Binding DataContext.EditConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Edit24" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 4B. DENSE TABLE VIEW (FLUENT UI DATA GRID) -->
            <Border Visibility="{Binding IsTableView, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="0" Margin="0" ClipToBounds="True">
                <ListView ItemsSource="{Binding FilteredCards}"
                          Background="Transparent" BorderThickness="0"
                          Padding="0" Margin="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          ItemContainerStyle="{StaticResource FluentTableRowStyle}"
                          MouseDoubleClick="OnTableItemDoubleClick"
                          GridViewColumnHeader.Click="OnColumnHeaderClick">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource FluentColumnHeaderStyle}">
                            <!-- Bookmark Column -->
                            <GridViewColumn Width="56">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Tag="Bookmark">
                                        <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="11" Foreground="#FFB900" VerticalAlignment="Center"/>
                                        <ui:SymbolIcon Symbol="{Binding DataContext.BookmarkSortIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.BookmarkSortIconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" Padding="0" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" ToolTip="{Binding BookmarkTooltip}"
                                                Command="{Binding DataContext.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Focusable="False">
                                            <ui:SymbolIcon Symbol="Star24" FontSize="13" Foreground="{Binding BookmarkIconColor}">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Setter Property="Filled" Value="False"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBookmarked}" Value="True">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                                <Setter Property="Filled" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Status Column -->
                            <GridViewColumn Width="125">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Tag="Status">
                                        <TextBlock Text="Status" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <ui:SymbolIcon Symbol="{Binding DataContext.StatusSortIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.StatusSortIconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{Binding PingStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PingStatusText}" FontSize="11" FontWeight="Medium"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Protocol Column -->
                            <GridViewColumn Width="110">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Tag="Protocol">
                                        <TextBlock Text="Protocol" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <ui:SymbolIcon Symbol="{Binding DataContext.ProtocolSortIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.ProtocolSortIconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" Background="{Binding ProtocolBadgeColor}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Protocol}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Server Name Column -->
                            <GridViewColumn Width="200">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Tag="DisplayName">
                                        <TextBlock Text="Server Name" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <ui:SymbolIcon Symbol="{Binding DataContext.NameSortIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.NameSortIconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Host Address Column -->
                            <GridViewColumn Width="180">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Tag="Endpoint">
                                        <TextBlock Text="Host / IP" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <ui:SymbolIcon Symbol="{Binding DataContext.EndpointSortIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.EndpointSortIconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding FullAddress}" FontFamily="Consolas, Cascadia Code, Segoe UI" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Credential Column -->
                            <GridViewColumn Width="170">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Tag="Credential">
                                        <TextBlock Text="Credential Vault" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <ui:SymbolIcon Symbol="{Binding DataContext.CredentialSortIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.CredentialSortIconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Key24" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CredentialTitle}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Display Mode Column -->
                            <GridViewColumn Width="140">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Tag="DisplayMode">
                                        <TextBlock Text="Display Mode" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                        <ui:SymbolIcon Symbol="{Binding DataContext.DisplayModeSortIcon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.DisplayModeSortIconBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding DisplayModeText}" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Actions Column (Fluent UI Buttons) -->
                            <GridViewColumn Header="Actions" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Content="Connect" Appearance="Primary" Height="28" Padding="10,0" Margin="0,0,5,0" Cursor="Hand"
                                                       Command="{Binding DataContext.ConnectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Play24" FontSize="11"/>
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Height="28" Width="30" Padding="0" Margin="0,0,4,0" Cursor="Hand"
                                                       ToolTip="Test TCP Reachability"
                                                       Command="{Binding DataContext.PingCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Pulse24" FontSize="13"/>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Height="28" Width="30" Padding="0" Cursor="Hand"
                                                       ToolTip="Edit Connection"
                                                       Command="{Binding DataContext.EditConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="13"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- 4C. ZERO / EMPTY STATE -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Margin="0,40,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredCards.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <ui:SymbolIcon Symbol="ServerMultiple20" FontSize="28"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="No Connections Found" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                <TextBlock Text="No remote servers match your current filter or search criteria."
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Clear Filter" Command="{Binding ClearSearchCommand}" Margin="0,0,8,0" Height="32"/>
                    <ui:Button Content="+ New Server" Appearance="Primary" Command="{Binding AddConnectionCommand}" Height="32"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
