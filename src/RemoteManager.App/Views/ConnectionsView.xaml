<UserControl x:Class="RemoteManager.App.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:RemoteManager.App.ViewModels"
             Background="{DynamicResource ApplicationBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Card Hover and Selection Style -->
        <Style x:Key="ConnectionCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Filter Pill Button Style -->
        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Data Table Header Style -->
        <Style x:Key="FluentColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Table Row Style -->
        <Style x:Key="FluentTableRowStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <!-- 1. Page Header with Title & KPI Chips -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Action & Filter Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Collapsible Quick Connect Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 4. Main Content: Grid / Table / Empty State -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. PAGE HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="ServerMultiple20" FontSize="26" Margin="0,0,10,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="Connections &amp; Remote Servers" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Centralized management hub for RDP, SSH, VNC, and Web console sessions"
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="36,4,0,0"/>
            </StackPanel>

            <!-- KPI Metric Chips -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Total Servers -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Total: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- RDP Count -->
                <Border Background="#150078D4" BorderBrush="#300078D4" BorderThickness="1"
                        CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RDP: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding RdpCount}" FontSize="12" FontWeight="Bold" Foreground="#0078D4"/>
                    </StackPanel>
                </Border>

                <!-- SSH Count -->
                <Border Background="#15107C41" BorderBrush="#30107C41" BorderThickness="1"
                        CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SSH: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding SshCount}" FontSize="12" FontWeight="Bold" Foreground="#107C41"/>
                    </StackPanel>
                </Border>

                <!-- VNC Count -->
                <Border Background="#15D83B01" BorderBrush="#30D83B01" BorderThickness="1"
                        CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="VNC: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding VncCount}" FontSize="12" FontWeight="Bold" Foreground="#D83B01"/>
                    </StackPanel>
                </Border>

                <!-- Web Count -->
                <Border Background="#15881798" BorderBrush="#30881798" BorderThickness="1"
                        CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Web: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding WebCount}" FontSize="12" FontWeight="Bold" Foreground="#881798"/>
                    </StackPanel>
                </Border>

                <!-- Online Count -->
                <Border Background="#1510b981" BorderBrush="#3010b981" BorderThickness="1"
                        CornerRadius="6" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Online: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding OnlineCount}" FontSize="12" FontWeight="Bold" Foreground="#10b981"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. ACTION & FILTER TOOLBAR -->
        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Protocol Pills & Sort -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Protocol Pills -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="All" Command="{Binding SetProtocolFilterCommand}" CommandParameter="All">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="RDP" Command="{Binding SetProtocolFilterCommand}" CommandParameter="RDP">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterRdp}" Value="True">
                                            <Setter Property="Background" Value="#0078D4"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#0078D4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="SSH" Command="{Binding SetProtocolFilterCommand}" CommandParameter="SSH">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterSsh}" Value="True">
                                            <Setter Property="Background" Value="#107C41"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#107C41"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="VNC" Command="{Binding SetProtocolFilterCommand}" CommandParameter="VNC">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterVnc}" Value="True">
                                            <Setter Property="Background" Value="#D83B01"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#D83B01"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Web" Command="{Binding SetProtocolFilterCommand}" CommandParameter="Web">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFilterWeb}" Value="True">
                                            <Setter Property="Background" Value="#881798"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#881798"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Sort By ComboBox -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Sort:" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}"
                                  Width="130" Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>

                <!-- Right: Action Buttons & View Mode Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Ping -->
                    <ui:Button Command="{Binding PingAllCommand}" Appearance="Secondary" Height="34" Margin="0,0,8,0"
                            ToolTip="Check network reachability for all visible servers" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Pulse24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Ping" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Quick Connect Toggle -->
                    <ui:Button Command="{Binding ToggleQuickConnectCommand}" Appearance="Secondary" Height="34" Margin="0,0,12,0"
                            ToolTip="Toggle inline Quick Connect bar" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flash24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Quick Connect" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- View Switcher (Grid vs Table) -->
                    <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <!-- Grid Button -->
                            <Button ToolTip="Card Grid View" Command="{Binding SetViewModeCommand}" CommandParameter="Grid"
                                    Width="32" Height="28" Padding="0" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGridView}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <ui:SymbolIcon Symbol="Grid24" FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </Button>
                            <!-- Table Button -->
                            <Button ToolTip="Dense Table View" Command="{Binding SetViewModeCommand}" CommandParameter="Table"
                                    Width="32" Height="28" Padding="0" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTableView}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <ui:SymbolIcon Symbol="Table24" FontSize="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. COLLAPSIBLE QUICK CONNECT BAR -->
        <Border Grid.Row="2" Visibility="{Binding IsQuickConnectExpanded, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="Flash24" FontSize="16" Foreground="#FFB900" Margin="0,0,6,0"/>
                    <TextBlock Text="Instant Connect:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Protocol combo -->
                <ComboBox Grid.Column="1" SelectedIndex="0" Height="34" VerticalContentAlignment="Center"
                          x:Name="QuickPageProtocolCombo" SelectionChanged="OnQuickProtocolChanged">
                    <ComboBoxItem Content="RDP" Tag="RDP" IsSelected="True"/>
                    <ComboBoxItem Content="SSH" Tag="SSH"/>
                    <ComboBoxItem Content="VNC" Tag="VNC"/>
                    <ComboBoxItem Content="Web" Tag="Web"/>
                </ComboBox>

                <!-- Host input -->
                <ui:TextBox Grid.Column="3" PlaceholderText="Host or IP:Port (e.g. 192.168.1.100 or myserver.domain.com:3389)"
                            Text="{Binding QuickHost, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"/>

                <!-- Connect Button -->
                <ui:Button Grid.Column="5" Content="Connect Now" Appearance="Primary" Height="34" Padding="18,0"
                           Command="{Binding QuickConnectFromPageCommand}"/>
            </Grid>
        </Border>

        <!-- 4. MAIN CONTENT AREA: CARDS GRID OR TABLE VIEW -->
        <Grid Grid.Row="3">
            <!-- 4A. CARD GRID VIEW -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding FilteredCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="315" Margin="0,0,14,14" Style="{StaticResource ConnectionCardBorderStyle}"
                                    Cursor="Hand" ToolTip="Double-click to connect • Right-click for options">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.ConnectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>

                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Connect (Embedded Tab)"
                                                  Command="{Binding DataContext.ConnectTabbedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Connect (Fullscreen)"
                                                  Command="{Binding DataContext.ConnectFullscreenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Connect (Native MSTSC / Window)"
                                                  Command="{Binding DataContext.ConnectExternalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Ping / Test Port"
                                                  Command="{Binding DataContext.PingCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Copy Address"
                                                  Command="{Binding DataContext.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Edit Connection"
                                                  Command="{Binding DataContext.EditConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Duplicate Connection"
                                                  Command="{Binding DataContext.DuplicateConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="Delete Connection"
                                                  Command="{Binding DataContext.DeleteConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>

                                <Grid Margin="16,14">
                                    <Grid.RowDefinitions>
                                        <!-- Top Row: Protocol Badge, Ping Status, Options -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Server Name & Address -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Metadata Pills: Credential, Display Mode -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- Action Buttons -->
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Protocol Badge -->
                                        <Border Grid.Column="0" CornerRadius="4" Padding="8,3" Background="{Binding ProtocolBadgeColor}">
                                            <TextBlock Text="{Binding Protocol}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <!-- Live Ping Status Pill -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Ellipse Width="7" Height="7" Fill="{Binding PingStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PingStatusText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Options Menu Trigger -->
                                        <Button Grid.Column="2" Content="•••" Width="26" Height="26" Padding="0" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" ToolTip="More Options"
                                                Click="OnCardMenuClick"/>
                                    </Grid>

                                    <!-- Server Name & Address -->
                                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FullAddress}" FontSize="12" FontFamily="Consolas, Segoe UI"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Metadata Pills -->
                                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
                                        <!-- Credential Badge -->
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Key24" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CredentialTitle}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Display Mode Badge -->
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding DisplayModeText}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Card Action Buttons -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Connect Button -->
                                        <ui:Button Grid.Column="0" Content="Connect" Appearance="Primary" Height="30"
                                                   HorizontalAlignment="Stretch"
                                                   Command="{Binding DataContext.ConnectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}"/>

                                        <!-- Ping Test Button -->
                                        <Button Grid.Column="2" Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip="Test network reachability"
                                                Command="{Binding DataContext.PingCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Pulse24" FontSize="13"/>
                                        </Button>

                                        <!-- Edit Button -->
                                        <Button Grid.Column="4" Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip="Edit connection settings"
                                                Command="{Binding DataContext.EditConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Edit24" FontSize="13"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 4B. DENSE TABLE VIEW (FLUENT UI DATA GRID) -->
            <Border Visibility="{Binding IsTableView, Converter={StaticResource BoolToVis}}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="0" Margin="0" ClipToBounds="True">
                <ListView ItemsSource="{Binding FilteredCards}"
                          Background="Transparent" BorderThickness="0"
                          Padding="0" Margin="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          ItemContainerStyle="{StaticResource FluentTableRowStyle}"
                          MouseDoubleClick="OnTableItemDoubleClick">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource FluentColumnHeaderStyle}">
                            <!-- Status Column -->
                            <GridViewColumn Header="Status" Width="115">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{Binding PingStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PingStatusText}" FontSize="11" FontWeight="Medium"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Protocol Column -->
                            <GridViewColumn Header="Protocol" Width="85">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" Background="{Binding ProtocolBadgeColor}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Protocol}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Server Name Column -->
                            <GridViewColumn Header="Server Name" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Host Address Column -->
                            <GridViewColumn Header="Endpoint" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding FullAddress}" FontFamily="Consolas, Cascadia Code, Segoe UI" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Credential Column -->
                            <GridViewColumn Header="Credential Vault" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Key24" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CredentialTitle}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Display Mode Column -->
                            <GridViewColumn Header="Display Mode" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding DisplayModeText}" FontSize="10.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Actions Column (Fluent UI Buttons) -->
                            <GridViewColumn Header="Actions" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Content="Connect" Appearance="Primary" Height="28" Padding="10,0" Margin="0,0,5,0" Cursor="Hand"
                                                       Command="{Binding DataContext.ConnectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Play24" FontSize="11"/>
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Height="28" Width="30" Padding="0" Margin="0,0,4,0" Cursor="Hand"
                                                       ToolTip="Test TCP Reachability"
                                                       Command="{Binding DataContext.PingCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Pulse24" FontSize="13"/>
                                            </ui:Button>
                                            <ui:Button Appearance="Secondary" Height="28" Width="30" Padding="0" Cursor="Hand"
                                                       ToolTip="Edit Connection"
                                                       Command="{Binding DataContext.EditConnectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="13"/>
                                            </ui:Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- 4C. ZERO / EMPTY STATE -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Margin="0,40,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredCards.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <ui:SymbolIcon Symbol="ServerMultiple20" FontSize="28"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="No Connections Found" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                <TextBlock Text="No remote servers match your current filter or search criteria."
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Clear Filter" Command="{Binding ClearSearchCommand}" Margin="0,0,8,0" Height="32"/>
                    <ui:Button Content="+ New Server" Appearance="Primary" Command="{Binding AddConnectionCommand}" Height="32"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
