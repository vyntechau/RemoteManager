<Window x:Class="RemoteManager.App.Views.FullscreenSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Fullscreen Session"
        WindowState="Maximized"
        WindowStyle="None"
        Icon="/Assets/vyntech-logo.png"
        Background="Black"
        KeyDown="OnWindowKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Action Bar (Row 0 - Never occluded by WinForms/ActiveX HWND) -->
        <Border Grid.Row="0" x:Name="TopActionBar"
                Background="#EE1A1A1A"
                BorderBrush="#33FFFFFF"
                BorderThickness="0,0,0,1"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title, Protocol Badge & Address -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionTitleText" Text="Server Session" FontWeight="SemiBold"
                               FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Border x:Name="ProtocolBadge" Background="#0078D4" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="ProtocolText" Text="RDP" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <TextBlock x:Name="SessionAddressText" Text="" FontSize="11"
                               Foreground="#88FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Ctrl+Alt+Del" Click="OnCadClick"
                               Height="28" Padding="10,0" Margin="0,0,8,0"
                               ToolTip="Send Ctrl+Alt+Del to remote machine" />

                    <ui:Button Content="Copy" Click="OnCopyClick"
                               Height="28" Padding="10,0" Margin="0,0,8,0"
                               ToolTip="Send Copy (Ctrl+C) to remote machine" />

                    <ui:Button Content="Paste" Click="OnPasteClick"
                               Height="28" Padding="10,0" Margin="0,0,8,0"
                               ToolTip="Send Paste (Ctrl+V) to remote machine" />

                    <ui:Button Content="Exit Fullscreen (F11)" Click="OnExitFullscreenClick"
                               Height="28" Padding="10,0" Margin="0,0,8,0"
                               ToolTip="Exit fullscreen mode (F11 / Esc)" />

                    <ui:Button Content="Disconnect" Click="OnDisconnectClick"
                               Appearance="Danger" Height="28" Padding="12,0"
                               ToolTip="Disconnect from remote session" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Session Content (Row 1) -->
        <ContentControl Grid.Row="1" x:Name="SessionHostContainer" />
    </Grid>
</Window>
