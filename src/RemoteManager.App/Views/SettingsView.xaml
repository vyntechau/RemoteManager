<UserControl x:Class="RemoteManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource ApplicationBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,32">
        <StackPanel MaxWidth="820" MinWidth="640" HorizontalAlignment="Center">
            <!-- Page Title -->
            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Customize appearance, connection defaults, security vault, and app preferences"
                           FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- SECTION 1: APPEARANCE -->
            <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>
            
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18,16" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="App Theme" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Select whether to match your Windows system settings or choose a fixed theme"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1" x:Name="ThemeComboBox" Width="180" Height="34"
                              VerticalContentAlignment="Center" Padding="10,0,28,0"
                              SelectionChanged="OnThemeSelectionChanged" VerticalAlignment="Center">
                        <ComboBoxItem Content="System (Default)" Tag="System" IsSelected="True"/>
                        <ComboBoxItem Content="Dark Mode" Tag="Dark"/>
                        <ComboBoxItem Content="Light Mode" Tag="Light"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- SECTION 2: CONNECTION DEFAULTS -->
            <TextBlock Text="Connection Defaults" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18,16" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Default Display Mode -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Default Display Mode" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Choose how sessions open when clicking Connect"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1" x:Name="DefaultModeComboBox" Width="180" Height="34"
                                  VerticalContentAlignment="Center" Padding="10,0,28,0"
                                  SelectionChanged="OnDefaultModeChanged" VerticalAlignment="Center">
                            <ComboBoxItem Content="Embedded Tab" Tag="Tabbed" IsSelected="True"/>
                            <ComboBoxItem Content="Fullscreen (F11)" Tag="Fullscreen"/>
                            <ComboBoxItem Content="External Window (MSTSC)" Tag="ExternalApp"/>
                        </ComboBox>
                    </Grid>

                    <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Auto Reconnect Toggle -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Auto-Reconnect on Dropped Session" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Automatically attempt to reconnect if an active remote session gets interrupted"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1" x:Name="AutoReconnectCheckBox" VerticalAlignment="Center"
                                  Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                    </Grid>

                    <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Warn Before Disconnect -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Confirm Before Closing Active Sessions" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Prompt for confirmation when closing a tab with a running connection"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1" x:Name="WarnDisconnectCheckBox" IsChecked="True" VerticalAlignment="Center"
                                  Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 3: SSH CLIENT PREFERENCES -->
            <TextBlock Text="SSH Client Preferences" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18,16" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Client Selector -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Installed / Preferred SSH Client" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Select a system-detected SSH client or configure your own custom executable"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1" x:Name="SshClientComboBox" Width="220" Height="34"
                                  VerticalContentAlignment="Center" Padding="10,0,28,0"
                                  DisplayMemberPath="FormattedName" SelectedValuePath="Id"
                                  SelectionChanged="OnSshClientSelectionChanged" />
                    </Grid>

                    <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,14"/>

                    <!-- Scan System Clients Button -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Scan System for SSH Clients" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Detect newly installed clients across standard directories, PATH, and registry"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Scan for Clients" ToolTip="Rescan system for installed clients"
                                    Click="OnRescanSshClientsClick" Height="34" Width="220"/>
                            <TextBlock x:Name="ScanResultTextBlock"
                                       Text=""
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#4CAF50"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Custom Client Options (Visible if 'Custom' or when client executable needs path) -->
                    <StackPanel x:Name="CustomSshPanel" Visibility="Collapsed">
                        <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,14"/>

                        <!-- Not detected warning banner -->
                        <Border x:Name="ClientNotDetectedBanner" Background="#33D83B01" BorderBrush="#D83B01" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ClientNotDetectedBannerText"
                                           Text="Selected client was not detected in standard system locations. Please specify the executable path."
                                           FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="CustomSshHeaderTextBlock" Text="Custom Executable Path" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" x:Name="CustomSshPathTextBox"
                                        PlaceholderText="C:\Path\To\ssh-client.exe"
                                        TextChanged="OnCustomSshPathChanged" Height="34" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseCustomSshClick" Height="34" Padding="14,0"/>
                        </Grid>

                        <TextBlock Text="Arguments Template" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <ui:TextBox x:Name="CustomSshArgsTextBox"
                                    PlaceholderText="{}{user}@{host} -p {port}"
                                    TextChanged="OnCustomSshArgsChanged" Height="34" Margin="0,0,0,4"/>
                        <TextBlock Text="Available placeholders: {host}, {port}, {user}"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION 4: VNC CLIENT PREFERENCES -->
            <TextBlock Text="VNC Client Preferences" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18,16" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Client Selector -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="VNC Viewer Mode" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Use the built-in tabbed VNC desktop viewer or delegate to an external VNC client"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1" x:Name="VncClientComboBox" Width="220" Height="34"
                                  VerticalContentAlignment="Center" Padding="10,0,28,0"
                                  DisplayMemberPath="FormattedName" SelectedValuePath="Id"
                                  SelectionChanged="OnVncClientSelectionChanged" />
                    </Grid>

                    <!-- Custom VNC Client Options -->
                    <StackPanel x:Name="CustomVncPanel" Visibility="Collapsed">
                        <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,14"/>

                        <Border x:Name="VncClientNotDetectedBanner" Background="#33D83B01" BorderBrush="#D83B01" BorderThickness="1"
                                CornerRadius="6" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VncClientNotDetectedBannerText"
                                           Text="Selected client was not detected in standard system locations. Please specify the executable path."
                                           FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="CustomVncHeaderTextBlock" Text="Custom VNC Executable Path" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Grid.Column="0" x:Name="CustomVncPathTextBox"
                                        PlaceholderText="C:\Program Files\uvnc bvba\UltraVNC\vncviewer.exe"
                                        TextChanged="OnCustomVncPathChanged" Height="34" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseCustomVncClick" Height="34" Padding="14,0"/>
                        </Grid>

                        <TextBlock Text="Arguments Template" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                        <ui:TextBox x:Name="CustomVncArgsTextBox"
                                    PlaceholderText="{}{host}:{port}"
                                    TextChanged="OnCustomVncArgsChanged" Height="34" Margin="0,0,0,4"/>
                        <TextBlock Text="Available placeholders: {host}, {port}, {password}"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION 5: SECURITY & DATA VAULT -->
            <TextBlock Text="Security &amp; Local Storage" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18,16" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Encryption Status -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Encryption Status" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,10,0"/>
                                <Border Background="#107C41" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="DPAPI ACTIVE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="All credentials are encrypted via Windows Data Protection API tied to your local user login"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Database Location -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="SQLite Database Path" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="DbPathTextBlock" Text="%LocalAppData%\RemoteManager\remotemanager.db"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Open Folder" Click="OnOpenFolderClick" Height="32" Padding="14,0" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Web Profiles -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Isolated Web Profiles Cache" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Clear cached logins and temporary storage created by embedded Web session tabs"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1" Content="Clear Web Cache" Click="OnClearWebCacheClick" Height="32" Padding="14,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SECTION 6: LOGGING & DIAGNOSTICS -->
            <TextBlock Text="Logging &amp; Diagnostics" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18,16" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Master Logging Switch -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Enable Diagnostic Logging" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Collect diagnostic logs and connection lifecycle events into daily files (logs/yyyy-MM-dd.log)"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ui:ToggleSwitch Grid.Column="1" x:Name="LoggingEnabledSwitch"
                                         Checked="OnLoggingOptionChanged" Unchecked="OnLoggingOptionChanged"
                                         VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Minimum Log Level -->
                    <Grid Margin="0,0,0,16" x:Name="LogLevelContainerGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Minimum Log Level" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Filter out events below this severity threshold"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ComboBox Grid.Column="1" x:Name="MinLogLevelComboBox" Width="200" Height="34"
                                  VerticalContentAlignment="Center" Padding="10,0,28,0"
                                  SelectionChanged="OnMinLogLevelSelectionChanged" VerticalAlignment="Center">
                            <ComboBoxItem Content="Trace (Everything)" Tag="Trace"/>
                            <ComboBoxItem Content="Debug (Detailed)" Tag="Debug"/>
                            <ComboBoxItem Content="Info (Standard)" Tag="Info"/>
                            <ComboBoxItem Content="Warn (Warnings &amp; Errors)" Tag="Warn"/>
                            <ComboBoxItem Content="Error (Errors Only)" Tag="Error"/>
                        </ComboBox>
                    </Grid>

                    <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Module Logging Options -->
                    <StackPanel x:Name="ModuleOptionsPanel">
                        <TextBlock Text="Module-Specific Logging Options" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Choose which application subsystems and protocols record diagnostic logs"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

                        <!-- Modules List -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="App Lifecycle &amp; UI" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Startup environment, window states, theme, and tab navigation" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="LogAppSwitch" Checked="OnLoggingOptionChanged" Unchecked="OnLoggingOptionChanged" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Database &amp; SQLite Storage" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Table schemas, connection item CRUD, and group persistence" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="LogDbSwitch" Checked="OnLoggingOptionChanged" Unchecked="OnLoggingOptionChanged" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="RDP Protocol" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Remote Desktop ActiveX control, mstsc isolated launches, disconnect reasons" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="LogRdpSwitch" Checked="OnLoggingOptionChanged" Unchecked="OnLoggingOptionChanged" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="SSH Protocol" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Terminal client detector, external SSH process execution, exit codes" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="LogSshSwitch" Checked="OnLoggingOptionChanged" Unchecked="OnLoggingOptionChanged" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VNC Protocol" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="RFB protocol handshake, authentication password prompts, resolution updates" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="LogVncSwitch" Checked="OnLoggingOptionChanged" Unchecked="OnLoggingOptionChanged" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Web Browser Sessions" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="WebView2 profile creation, navigation started and completed status" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="LogWebSwitch" Checked="OnLoggingOptionChanged" Unchecked="OnLoggingOptionChanged" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Security &amp; Vault Operations" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="DPAPI encryption, credential lookup (secrets and passwords remain strictly masked)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" x:Name="LogSecuritySwitch" Checked="OnLoggingOptionChanged" Unchecked="OnLoggingOptionChanged" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION 6: APPLICATION UPDATES -->
            <TextBlock Text="Updates &amp; Releases" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="18,16" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Auto-Check for Updates Toggle -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Check for updates automatically" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Periodically check GitHub Releases on application startup and show notification status"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="AutoCheckUpdatesCheckBox" VerticalAlignment="Center"
                                  Checked="OnUpdateSettingToggled" Unchecked="OnUpdateSettingToggled"/>
                    </Grid>

                    <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Pre-releases Toggle -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Include Pre-release versions" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Receive early preview and beta builds before official stable release"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="IncludePrereleasesCheckBox" VerticalAlignment="Center"
                                  Checked="OnUpdateSettingToggled" Unchecked="OnUpdateSettingToggled"/>
                    </Grid>

                    <Separator Background="{DynamicResource ControlElevationBorderBrush}" Margin="0,0,0,16"/>

                    <!-- Manual Check Button & Info -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="GitHub Release Channel" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="LastUpdateCheckTextBlock" Text="Repository: vyntechau/RemoteManager"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1" Content="Check Now" Click="OnCheckUpdatesClick"
                                   Appearance="Secondary" Height="32" Padding="14,0" VerticalAlignment="Center">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24"/>
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
