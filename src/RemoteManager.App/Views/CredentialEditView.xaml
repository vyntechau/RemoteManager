<UserControl x:Class="RemoteManager.App.Views.CredentialEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource ApplicationBackgroundBrush}"
             TextElement.Foreground="White"
             Foreground="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Default TextBlock Style for Dark Mode Clarity -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <!-- 1. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Scrollable Form -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. PAGE HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Button Grid.Column="0" Click="OnBackClick" Width="36" Height="36" Padding="0" Margin="0,0,16,0"
                    VerticalAlignment="Center" ToolTip="Back to Vault" Cursor="Hand">
                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
            </Button>

            <!-- Page Title -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitleText" Text="New Vault Credential" FontSize="22" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Store encrypted authentication credentials locally using Windows DPAPI"
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Header Actions (Zero Cancel Button) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Save Credential" Appearance="Primary" Click="OnSaveClick" Height="34" Width="140" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- 2. MAIN SCROLLABLE FORM -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <!-- SECTION 1: CREDENTIAL PROFILE -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Credential Profile" FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,0,0,14"/>

                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="Credential Title / Label *" FontWeight="Medium" Margin="0,0,0,6"
                                       Foreground="White"/>
                            <ui:TextBox x:Name="TitleInput" PlaceholderText="e.g. Production Cluster Admin (Alice) or Bastion Root"
                                        TextChanged="OnFormTextChanged"/>
                            <TextBlock x:Name="TitleErrorText" Text="Please provide a descriptive title for this credential."
                                       FontSize="11" Foreground="#E81123" Margin="2,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: AUTHENTICATION DETAILS -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Authentication Details" FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Username -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Username *" FontWeight="Medium" Margin="0,0,0,6"
                                           Foreground="White"/>
                                <ui:TextBox x:Name="UsernameInput" PlaceholderText="e.g. administrator or root"
                                            TextChanged="OnFormTextChanged"/>
                                <TextBlock x:Name="UsernameErrorText" Text="Username is required."
                                           FontSize="11" Foreground="#E81123" Margin="2,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Domain -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Domain (Optional for Windows)" FontWeight="Medium" Margin="0,0,0,6"
                                           Foreground="White"/>
                                <ui:TextBox x:Name="DomainInput" PlaceholderText="e.g. CORP or WORKGROUP"/>
                            </StackPanel>
                        </Grid>

                        <!-- Password -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Password" FontWeight="Medium" Margin="0,0,0,6"
                                       Foreground="White"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PasswordInput" Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                                             PasswordChanged="OnPasswordChanged"
                                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                                             Foreground="White" BorderBrush="{DynamicResource ControlElevationBorderBrush}"/>
                                <ui:TextBox x:Name="PasswordVisibleInput" Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                                            Visibility="Collapsed" TextChanged="OnVisiblePasswordChanged"/>
                                <Button Grid.Column="1" Click="OnTogglePasswordVisibility" Width="36" Height="34" Margin="6,0,0,0"
                                        ToolTip="Toggle Password Visibility" Cursor="Hand" Padding="0">
                                    <ui:SymbolIcon x:Name="PasswordEyeIcon" Symbol="Eye24" FontSize="14"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Notes -->
                        <StackPanel>
                            <TextBlock Text="Notes / Description (Optional)" FontWeight="Medium" Margin="0,0,0,6"
                                       Foreground="White"/>
                            <TextBox x:Name="NotesInput" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Padding="10,8"
                                     Background="{DynamicResource ControlFillColorDefaultBrush}"
                                     Foreground="White" BorderBrush="{DynamicResource ControlElevationBorderBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: DPAPI SECURITY ASSURANCE -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                Background="#200078D4" Margin="0,0,14,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="#0078D4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Zero Cloud Exposure • Local DPAPI Encryption" FontWeight="SemiBold" FontSize="13"
                                       Foreground="White"/>
                            <TextBlock Text="Credentials are encrypted using the Windows Data Protection API (CryptProtectData). The secret is encrypted with your current Windows user profile key and never leaves your local system."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
