<UserControl x:Class="RemoteManager.App.Views.ConnectionEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource ApplicationBackgroundBrush}"
             TextElement.Foreground="White"
             Foreground="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Default TextBlock Style for Dark Mode Clarity -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Protocol Tile Selection Style -->
        <Style x:Key="ProtocolTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Display Mode Tile Style -->
        <Style x:Key="DisplayModeTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <!-- 1. Navigation & Page Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Main Scrollable Form & Preview Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. PAGE HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back Button -->
            <Button Grid.Column="0" Click="OnBackClick" Width="36" Height="36" Padding="0" Margin="0,0,16,0"
                    VerticalAlignment="Center" ToolTip="Back to Connections" Cursor="Hand">
                <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="16"/>
            </Button>

            <!-- Page Title & Subtitle -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitleText" Text="New Remote Connection" FontSize="22" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock x:Name="PageSubtitleText" Text="Configure server endpoints, protocol parameters, and authentication credentials"
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Quick Action Buttons in Header (Zero Cancel Button) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="SaveAndConnectButton" Content="Save &amp; Connect" Appearance="Secondary"
                           Click="OnSaveAndConnectClick" Height="34" Margin="0,0,8,0" Cursor="Hand"/>
                <ui:Button Content="Save Connection" Appearance="Primary" Click="OnSaveClick" Height="34" Width="140" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- 2. MAIN SCROLLABLE WORKSPACE (2 COLUMNS: FORM + LIVE PREVIEW) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Form Column -->
                    <ColumnDefinition Width="3*" MinWidth="480"/>
                    <ColumnDefinition Width="24"/>
                    <!-- Live Preview & Diagnostic Column -->
                    <ColumnDefinition Width="2*" MinWidth="320" MaxWidth="440"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: FORM CARDS -->
                <StackPanel Grid.Column="0">

                    <!-- SECTION A: PROTOCOL SELECTION -->
                    <TextBlock Text="Protocol" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- RDP Tile -->
                        <Border Grid.Column="0" x:Name="TileRdp" Style="{StaticResource ProtocolTileStyle}" MouseLeftButtonDown="OnSelectRdp">
                            <StackPanel HorizontalAlignment="Center">
                                <Border CornerRadius="4" Padding="8,2" Background="#0078D4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="RDP" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Remote Desktop" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- SSH Tile -->
                        <Border Grid.Column="2" x:Name="TileSsh" Style="{StaticResource ProtocolTileStyle}" MouseLeftButtonDown="OnSelectSsh">
                            <StackPanel HorizontalAlignment="Center">
                                <Border CornerRadius="4" Padding="8,2" Background="#107C41" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="SSH" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="Terminal" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- VNC Tile -->
                        <Border Grid.Column="4" x:Name="TileVnc" Style="{StaticResource ProtocolTileStyle}" MouseLeftButtonDown="OnSelectVnc">
                            <StackPanel HorizontalAlignment="Center">
                                <Border CornerRadius="4" Padding="8,2" Background="#D83B01" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="VNC" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="VNC Viewer" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Web Tile -->
                        <Border Grid.Column="6" x:Name="TileWeb" Style="{StaticResource ProtocolTileStyle}" MouseLeftButtonDown="OnSelectWeb">
                            <StackPanel HorizontalAlignment="Center">
                                <Border CornerRadius="4" Padding="8,2" Background="#881798" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="Web" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Text="HTTPS/HTTP" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- SECTION B: GENERAL & ENDPOINT DETAILS -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Server Information &amp; Network Endpoint" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" Margin="0,0,0,16"/>

                            <!-- Connection Name -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Connection Name *" FontWeight="Medium" Foreground="White" Margin="0,0,0,6"/>
                                <ui:TextBox x:Name="NameInput" PlaceholderText="e.g. Production Database Cluster"
                                            TextChanged="OnFormInputChanged"/>
                                <TextBlock x:Name="NameErrorText" Text="Please provide a descriptive connection name."
                                           FontSize="11" Foreground="#E81123" Margin="2,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- Host & Port Grid -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Host / IP -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Host / IP Address *" FontWeight="Medium" Foreground="White" Margin="0,0,0,6"/>
                                    <ui:TextBox x:Name="HostInput" PlaceholderText="e.g. 192.168.1.100 or server.corp.local"
                                                TextChanged="OnFormInputChanged"/>
                                    <TextBlock x:Name="HostErrorText" Text="Please enter a valid hostname or IP address."
                                               FontSize="11" Foreground="#E81123" Margin="2,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- Port -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Port *" FontWeight="Medium" Foreground="White" Margin="0,0,0,6"/>
                                    <ui:TextBox x:Name="PortInput" Text="3389" TextChanged="OnFormInputChanged"/>
                                    <TextBlock x:Name="PortErrorText" Text="1-65535"
                                               FontSize="11" Foreground="#E81123" Margin="2,4,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION C: AUTHENTICATION & CREDENTIALS (INLINE ENTRY + VAULT PICKER) -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Authentication &amp; Credentials" FontSize="15" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>

                                <!-- Mode Switch Segmented Options -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="RadioVaultCred" Content="Select from Vault" IsChecked="True"
                                                 Checked="OnCredModeChanged" Margin="0,0,16,0" Foreground="White"
                                                 VerticalContentAlignment="Center" Cursor="Hand"/>
                                    <RadioButton x:Name="RadioCustomCred" Content="Enter Directly Here"
                                                 Checked="OnCredModeChanged" Foreground="White"
                                                 VerticalContentAlignment="Center" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>

                            <!-- OPTION 1: VAULT PICKER AREA -->
                            <StackPanel x:Name="VaultPickerArea" Visibility="Visible">
                                <TextBlock Text="Select a secure credential from the DPAPI encrypted vault, or prompt interactively upon connecting."
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                                <ComboBox x:Name="CredentialPicker" Height="36" VerticalContentAlignment="Center"
                                          DisplayMemberPath="Title" SelectedValuePath="Id"
                                          SelectionChanged="OnCredentialSelectionChanged" Margin="0,0,0,8"/>
                                <TextBlock Text="Tip: Multiple connections can safely share the same vault credential without password duplication."
                                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>

                            <!-- OPTION 2: INLINE CREDENTIAL ENTRY AREA -->
                            <StackPanel x:Name="InlineCredArea" Visibility="Collapsed">
                                <TextBlock Text="Enter authentication credentials directly for this server. Passwords are encrypted at rest using Windows DPAPI."
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

                                <!-- Username & Domain Grid -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Username -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Username" FontWeight="Medium" Foreground="White" Margin="0,0,0,6"/>
                                        <ui:TextBox x:Name="InlineUsernameInput" PlaceholderText="e.g. administrator or root"
                                                    TextChanged="OnInlineCredChanged"/>
                                    </StackPanel>

                                    <!-- Domain -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Domain (Optional)" FontWeight="Medium" Foreground="White" Margin="0,0,0,6"/>
                                        <ui:TextBox x:Name="InlineDomainInput" PlaceholderText="e.g. CORP or WORKGROUP"
                                                    TextChanged="OnInlineCredChanged"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Password Input with Eye Toggle -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Password" FontWeight="Medium" Foreground="White" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="InlinePasswordInput" Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                                                     PasswordChanged="OnInlinePasswordChanged"
                                                     Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                     Foreground="White" BorderBrush="{DynamicResource ControlElevationBorderBrush}"/>
                                        <ui:TextBox x:Name="InlinePasswordVisibleInput" Grid.Column="0" Height="34" VerticalContentAlignment="Center"
                                                    Visibility="Collapsed" TextChanged="OnInlineVisiblePasswordChanged"/>
                                        <Button Grid.Column="1" Click="OnToggleInlinePasswordVisibility" Width="36" Height="34" Margin="6,0,0,0"
                                                ToolTip="Toggle Password Visibility" Cursor="Hand" Padding="0">
                                            <ui:SymbolIcon x:Name="InlinePasswordEyeIcon" Symbol="Eye24" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Save to Vault Option -->
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,10" Margin="0,2,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="SaveToVaultCheckbox" Content="Save to Credential Vault for reuse across other connections"
                                                  IsChecked="True" Checked="OnSaveToVaultChecked" Unchecked="OnSaveToVaultChecked"
                                                  Foreground="White" Cursor="Hand"/>
                                        <StackPanel x:Name="VaultTitlePanel" Margin="24,8,0,0">
                                            <TextBlock Text="Vault Profile Title (Optional)" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                                            <ui:TextBox x:Name="InlineTitleInput" PlaceholderText="Auto-generates from connection name if left blank"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- SECTION D: DISPLAY & WINDOW MODE -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Display &amp; Session Launch Behavior" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Tabbed Tile -->
                                <Border Grid.Column="0" x:Name="TileTabbed" Style="{StaticResource DisplayModeTileStyle}" MouseLeftButtonDown="OnSelectTabbed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Embedded Tab" FontWeight="SemiBold" FontSize="12" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Opens inside application tab bar" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Fullscreen Tile -->
                                <Border Grid.Column="2" x:Name="TileFullscreen" Style="{StaticResource DisplayModeTileStyle}" MouseLeftButtonDown="OnSelectFullscreen">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="Fullscreen (F11)" FontWeight="SemiBold" FontSize="12" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Auto-hide toolbar borderless" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- External Native Window Tile -->
                                <Border Grid.Column="4" x:Name="TileExternal" Style="{StaticResource DisplayModeTileStyle}" MouseLeftButtonDown="OnSelectExternal">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="External App" FontWeight="SemiBold" FontSize="12" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <TextBlock Text="Native MSTSC / viewer window" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bookmark Option -->
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                                <CheckBox x:Name="IsBookmarkedCheckbox" Content="Bookmark this server (pin to show on top of lists)"
                                          Foreground="White" Cursor="Hand"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT: LIVE SERVER PREVIEW & DIAGNOSTICS -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Live Preview" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" Margin="0,0,0,8"/>

                    <!-- Real-time Preview Card -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="1.5"
                            CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Top Preview Row -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Protocol Badge -->
                                <Border Grid.Column="0" x:Name="PreviewProtocolBadge" CornerRadius="4" Padding="8,3" Background="#0078D4">
                                    <TextBlock x:Name="PreviewProtocolText" Text="RDP" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>

                                <!-- Status preview pill -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="#8A8886" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PreviewPingText" Text="Ready to test" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Name & Address -->
                            <TextBlock x:Name="PreviewNameText" Text="New Remote Connection" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="PreviewAddressText" Text="host:3389" FontSize="12" FontFamily="Consolas, Segoe UI"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,10"/>

                            <!-- Badges -->
                            <WrapPanel Margin="0,0,0,12">
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Key24" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="PreviewCredentialText" Text="(None / Prompt)" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="PreviewDisplayModeText" Text="Embedded Tab" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </Border>
                            </WrapPanel>

                            <!-- Inline Connectivity Test Button -->
                            <Button x:Name="TestEndpointButton" Click="OnTestConnectivityClick" Height="32" Cursor="Hand" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Pulse24" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TestEndpointButtonText" Text="Test Port Reachability" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Design Guidance Tip -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Product Pattern Standard" FontWeight="SemiBold" FontSize="12"
                                       Foreground="White" Margin="0,0,0,4"/>
                            <TextBlock Text="RemoteManager connects directly to native protocol sockets with zero cloud intermediaries. Changes take effect immediately upon saving."
                                       FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
