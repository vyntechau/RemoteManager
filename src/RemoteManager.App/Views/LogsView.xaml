<UserControl x:Class="RemoteManager.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:RemoteManager.App.ViewModels"
             Background="{DynamicResource ApplicationBackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Filter & Action Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Log Entries List -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. PAGE HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="24" Margin="0,0,10,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="System &amp; Session Logs" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Real-time diagnostics, protocol handshakes, credential events, and daily rotating log files"
                           FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="34,4,0,0"/>
            </StackPanel>

            <!-- Metrics / Counts Badges -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Info Count Badge -->
                <Border Background="#150078D4" BorderBrush="#300078D4" BorderThickness="1"
                        CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Info: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding InfoCount}" FontSize="12" FontWeight="SemiBold" Foreground="#0078D4"/>
                    </StackPanel>
                </Border>

                <!-- Warning Count Badge -->
                <Border Background="#15D83B01" BorderBrush="#30D83B01" BorderThickness="1"
                        CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Warnings: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding WarningCount}" FontSize="12" FontWeight="SemiBold" Foreground="#D83B01"/>
                    </StackPanel>
                </Border>

                <!-- Error Count Badge -->
                <Border Background="#15E81123" BorderBrush="#30E81123" BorderThickness="1"
                        CornerRadius="6" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Errors: " FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding ErrorCount}" FontSize="12" FontWeight="SemiBold" Foreground="#E81123"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. FILTER & ACTION TOOLBAR (RESPONSIVE) -->
        <Border Grid.Row="1" x:Name="ToolbarBorder"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,10,12,4" Margin="0,0,0,12"
                SizeChanged="OnToolbarSizeChanged">
            <Grid x:Name="ToolbarGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0" x:Name="ToolbarSecondRowDef"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" x:Name="ToolbarLeftColDef"/>
                    <ColumnDefinition Width="Auto" x:Name="ToolbarRightColDef"/>
                </Grid.ColumnDefinitions>

                <!-- Filters Wrap Panel -->
                <WrapPanel x:Name="FiltersPanel" Grid.Row="0" Grid.Column="0"
                           Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Input -->
                    <ui:TextBox PlaceholderText="Search logs (message, source...)"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Width="210" Height="34" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                Margin="0,0,8,6">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24"/>
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- Level ComboBox -->
                    <ComboBox ItemsSource="{Binding LevelOptions}"
                              SelectedItem="{Binding SelectedLevel}"
                              Width="120" Height="34" VerticalAlignment="Center"
                              VerticalContentAlignment="Center" Padding="10,0,28,0"
                              Margin="0,0,8,6"
                              ToolTip="Filter by minimum severity level">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Category ComboBox -->
                    <ComboBox ItemsSource="{Binding CategoryOptions}"
                              SelectedItem="{Binding SelectedCategory}"
                              Width="145" Height="34" VerticalAlignment="Center"
                              VerticalContentAlignment="Center" Padding="10,0,28,0"
                              Margin="0,0,8,6"
                              ToolTip="Filter by source component">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Daily File Selector -->
                    <ComboBox ItemsSource="{Binding AvailableFiles}"
                              SelectedItem="{Binding SelectedFile}"
                              Width="180" Height="34" VerticalAlignment="Center"
                              VerticalContentAlignment="Center" Padding="10,0,28,0"
                              Margin="0,0,8,6"
                              ToolTip="Select Live Stream or historical daily log file (logs/yyyy-MM-dd.log)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </WrapPanel>

                <!-- Action Buttons Wrap Panel -->
                <WrapPanel x:Name="ActionsPanel" Grid.Row="0" Grid.Column="1"
                           Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Auto-Scroll Toggle Button -->
                    <ToggleButton IsChecked="{Binding IsAutoScrollEnabled, Mode=TwoWay}"
                                  ToolTip="Toggle Auto-Scroll to latest log entry"
                                  Height="34" Padding="10,0" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDown24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Auto-Scroll" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Copy Logs Button -->
                    <ui:Button Appearance="Secondary" Command="{Binding CopyLogsCommand}"
                               ToolTip="Copy selected log entry or all filtered logs to clipboard"
                               Height="34" Padding="10,0" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Copy" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Clear Logs Button -->
                    <ui:Button Appearance="Secondary" Command="{Binding ClearLogsCommand}"
                               ToolTip="Clear current log view"
                               Height="34" Padding="10,0" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Clear" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Export Button -->
                    <ui:Button Appearance="Secondary" Command="{Binding ExportLogsCommand}"
                               ToolTip="Export current log entries to file"
                               Height="34" Padding="10,0" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Export" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Open Logs Folder Button -->
                    <ui:Button Appearance="Secondary" Command="{Binding OpenLogsFolderCommand}"
                               ToolTip="Open the logs directory in Windows Explorer"
                               Height="34" Padding="10,0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Logs Folder" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 3. LOG ENTRIES LISTVIEW -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="2">
            <ListView x:Name="LogListView"
                      ItemsSource="{Binding FilteredLogs}"
                      SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      BorderThickness="0"
                      Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <!-- Timestamp -->
                                    <ColumnDefinition Width="170"/>
                                    <!-- Level Badge -->
                                    <ColumnDefinition Width="78"/>
                                    <!-- Category -->
                                    <ColumnDefinition Width="130"/>
                                    <!-- Message -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Timestamp -->
                                <TextBlock Grid.Column="0" Text="{Binding FormattedTimestamp}"
                                           FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"/>

                                <!-- Level Badge -->
                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="4" Padding="6,2"
                                        Background="{Binding LevelBadgeBackground}">
                                    <TextBlock Text="{Binding LevelBadgeText}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="{Binding LevelBadgeColor}" HorizontalAlignment="Center"/>
                                </Border>

                                <!-- Category / Source -->
                                <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Border>

                                <!-- Message -->
                                <TextBlock Grid.Column="3" Text="{Binding Message}"
                                           FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Collapsible Exception Box if Present -->
                            <Border Grid.Row="1" Margin="248,6,8,4" Padding="8"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="#40E81123" BorderThickness="1" CornerRadius="4"
                                    Visibility="{Binding HasException, Converter={StaticResource BoolToVis}}">
                                <TextBox Text="{Binding FullExceptionString, Mode=OneWay}"
                                         IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11"
                                         Foreground="#E81123" Background="Transparent"
                                         BorderThickness="0" MaxHeight="140"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- 4. BOTTOM FOOTER STATUS BAR -->
        <Grid Grid.Row="3" Margin="4,8,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Notification Banner -->
            <TextBlock Grid.Column="0" Text="{Binding StatusNotification}"
                       FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <!-- Count Summary -->
            <TextBlock Grid.Column="1"
                       FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center">
                <Run Text="Total logs: "/>
                <Run Text="{Binding TotalCount}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Run Text=" | Auto-scroll: "/>
                <Run Text="{Binding IsAutoScrollEnabled}" FontWeight="SemiBold"/>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
